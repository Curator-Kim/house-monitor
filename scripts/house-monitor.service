[Unit]
Description=Daily residential price collection dispatcher
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/house-monitor
Environment=CHROMEDRIVER_PATH=%h/.local/bin/chromedriver
Environment=HOUSE_SCHEDULER_ENABLED=1
ExecStart=%h/house-monitor/.venv/bin/python -m house_monitor.cli tick
TimeoutStartSec=3600
